{
  "name": "college-event-platform",
  "private": true,
  "version": "0.1.0",
  "description": "College Event Operations Platform",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "setup:env": "node scripts/setup-env.mjs",
    "dev": "concurrently -n api,worker,web -c blue,magenta,green \"npm run dev -w apps/api\" \"npm run dev:worker -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "migrate": "npm run migrate -w apps/api --",
    "create-admin": "npm run create-admin -w apps/api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "esbuild@0.28.2": true
  }
}
