# Copy to .env (or run `npm run setup:env`, which also generates the secrets below).
# .env is gitignored. Never commit real credentials.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# --- PostgreSQL (docker compose reads POSTGRES_* ; the API reads DATABASE_URL) ---
POSTGRES_USER=events
POSTGRES_PASSWORD=__GENERATED_DB_PASSWORD__
POSTGRES_DB=events_dev
POSTGRES_PORT=5432
DATABASE_URL=postgres://events:__GENERATED_DB_PASSWORD__@localhost:5432/events_dev
# Automated tests use a separate database; the name must contain "test".
TEST_DATABASE_URL=postgres://events:__GENERATED_DB_PASSWORD__@localhost:5432/events_test

# --- Authentication ---
# At least 32 random characters. Generate with: openssl rand -base64 48
JWT_SECRET=__GENERATED_JWT_SECRET__
# Optional: a separate key for gate-pass QR codes (32+ characters). If unset, one is derived from JWT_SECRET.
# QR_SIGNING_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# --- Monitoring (optional) ---
# /metrics on the API (and the worker, if WORKER_METRICS_PORT is set) answers only to this bearer token.
# Leave empty to switch /metrics off. Generate with: openssl rand -base64 32
METRICS_TOKEN=__GENERATED_METRICS_TOKEN__
WORKER_METRICS_PORT=0

# --- Background tasks ---
# A published event closes itself this many hours after it ended (0 = never; the organizer can always close it by hand).
EVENT_AUTO_CLOSE_HOURS=24
# Password reset links expire after this many minutes.
PASSWORD_RESET_TTL_MINUTES=60

# --- Web / CORS ---
CORS_ORIGINS=http://localhost:5173
WEB_BASE_URL=http://localhost:5173

# --- Mail (Mailpit in development: SMTP 1025, web UI http://localhost:8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=College Events <no-reply@events.local>

# --- File storage (generated PDFs, uploads). Keep outside any web-served directory. ---
STORAGE_DIR=./storage

# --- First admin account, used only by `npm run create-admin` (choose your own password, 12+ chars) ---
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
